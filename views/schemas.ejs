<%- include('partials/header') %>

<section class="schemas-page">
  <div class="page-title-section">
    <h1>סכמות המשאבים במערכת (SSR Schemas)</h1>
    <p class="subtitle">עמוד זה מרונדר בצד השרת באמצעות EJS ומציג את מבנה הנתונים הרשמי עבור כל משאבי ה-API.</p>
  </div>

  <div class="schemas-grid">
    <% schemas.forEach(function(schema) { %>
      <div class="card schema-card">
        <div class="schema-header">
          <div class="schema-title-wrap">
            <span class="badge badge-primary">משאב</span>
            <h2><%= schema.name %></h2>
          </div>
          <div class="schema-endpoints">
            <code class="endpoint-tag">Endpoint: <%= schema.endpoint %></code>
            <% if (schema.nestedEndpoint) { %>
              <code class="endpoint-tag nested">Nested: <%= schema.nestedEndpoint %></code>
            <% } %>
          </div>
        </div>

        <p class="schema-desc"><%= schema.description %></p>

        <div class="table-responsive">
          <table class="schema-table">
            <thead>
              <tr>
                <th>שם השדה</th>
                <th>סוג נתונים</th>
                <th>חובה/אופציונלי</th>
                <th>תיאור השדה</th>
              </tr>
            </thead>
            <tbody>
              <% schema.fields.forEach(function(field) { %>
                <tr>
                  <td><code><%= field.name %></code></td>
                  <td><span class="type-pill type-<%= field.type.toLowerCase() %>"><%= field.type %></span></td>
                  <td>
                    <% if (field.required) { %>
                      <span class="status-tag required">חובה (Required)</span>
                    <% } else { %>
                      <span class="status-tag optional">אופציונלי</span>
                    <% } %>
                  </td>
                  <td><%= field.description %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% }); %>
  </div>

  <div class="schemas-nav-back">
    <a href="/" class="btn btn-primary">⬅️ חזרה למשחק השלבים</a>
  </div>
</section>

<%- include('partials/footer') %>
